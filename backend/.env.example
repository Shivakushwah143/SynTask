# SynTask backend environment example
# Copy this file to backend/.env and replace the placeholder values.

# Core application
ENVIRONMENT=development
SECRET_KEY=replace-with-a-strong-random-secret
ENCRYPTION_KEY=replace-with-a-valid-fernet-key

# Database
MONGODB_URL=mongodb://mongo:27017/alphanexis_task_management
DATABASE_NAME=alphanexis_task_management

# CORS and frontend URLs
ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:5173","http://127.0.0.1:5173","https://task.synzent.ai"]
ALLOWED_HOSTS=["localhost","127.0.0.1","task.synzent.ai"]
FRONTEND_URL=http://localhost:3000

# Email
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@alphanexis.com
MAIL_FROM_NAME=SynTask
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_TLS=True
MAIL_SSL=False

# IMAP recruitment inbox sync
IMAP_ENABLED=False
IMAP_HOST=
IMAP_PORT=993
IMAP_SSL=True
IMAP_USERNAME=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX
IMAP_POLL_SECONDS=60
IMAP_MARK_SEEN=True
IMAP_TARGET_COMPANY_EMAIL=

# Brevo
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=SynTask
BREVO_REPLY_TO=
BREVO_BASE_URL=https://api.brevo.com/v3
BREVO_TIMEOUT_SECONDS=20
BREVO_RETRY_ATTEMPTS=3

# Payments
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Zoom
ZOOM_API_KEY=
ZOOM_API_SECRET=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_ACCOUNT_ID=

# File uploads and storage
MAX_UPLOAD_SIZE=10485760
ALLOWED_EXTENSIONS=[".jpg",".jpeg",".png",".gif",".webp",".pdf",".doc",".docx",".xls",".xlsx",".txt",".zip"]
UPLOAD_DIR=uploads
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET_NAME=
AWS_REGION=us-east-1

# Redis and background jobs
REDIS_URL=redis://redis:6379/0
ENABLE_TOKEN_REVOCATION=True
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# Pagination and rate limits
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=500
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=60
AUTH_RATE_LIMIT_REQUESTS=10
AUTH_RATE_LIMIT_PERIOD=60

# Logging and AI
LOG_LEVEL=INFO
AI_PROVIDER=groq
GROQ_API_KEY=
OPENAI_API_KEY=
AI_TIMEOUT=30
AI_MAX_TOKENS=500
AI_TEMPERATURE=0.2
AI_MODEL_GROQ=llama-3.1-70b-versatile
AI_MODEL_OPENAI=gpt-4o-mini

# Bootstrap access
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=replace-with-a-strong-bootstrap-password
