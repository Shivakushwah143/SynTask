# ============================================================
# SynTask Backend - Environment Variables
# Copy this file to .env and fill in all values marked REQUIRED
# NEVER commit .env to version control
# ============================================================

# Application
ENVIRONMENT=development
PROJECT_NAME=SynTask
VERSION=1.0.0
COMPANY=SynTask
API_V1_PREFIX=/api/v1

# Security (REQUIRED)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_USE_64_CHAR_RANDOM_HEX
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=CHANGE_ME_USE_FERNET_KEY
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database (REQUIRED)
MONGODB_URL=mongodb+srv://USERNAME:PASSWORD@cluster.mongodb.net/?retryWrites=true&w=majority
DATABASE_NAME=alphanexis_task_management

# Super Admin (REQUIRED)
SUPER_ADMIN_EMAIL=admin@yourdomain.com
SUPER_ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD_MIN_16_CHARS

# Frontend and CORS
FRONTEND_URL=https://yourdomain.com
ALLOWED_ORIGINS=["https://task.synzent.ai"]
ALLOWED_HOSTS=["task.synzent.ai"]

# Redis (REQUIRED for token blacklist + caching)
REDIS_URL=redis://localhost:6379/0
ENABLE_TOKEN_REVOCATION=True
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Rate limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=60
AUTH_RATE_LIMIT_REQUESTS=10
AUTH_RATE_LIMIT_PERIOD=60

# Email (Optional - password reset emails)
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@yourdomain.com
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_FROM_NAME=SynTask
MAIL_TLS=True
MAIL_SSL=False

# Stripe (Optional)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Razorpay (Optional)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Zoom (Optional)
ZOOM_API_KEY=
ZOOM_API_SECRET=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_ACCOUNT_ID=

# AWS S3 (Optional)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET_NAME=
AWS_REGION=us-east-1

# Uploads
MAX_UPLOAD_SIZE=10485760
UPLOAD_DIR=uploads

# Logging
LOG_LEVEL=INFO
