# SynTask backend environment example
# Copy this file to backend/.env and replace the placeholder values.

# Core application
ENVIRONMENT=development
SECRET_KEY=replace-with-a-strong-random-secret
ENCRYPTION_KEY=replace-with-a-valid-fernet-key
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
AUTH_COOKIE_SECURE=True
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_DOMAIN=

# Database
MONGO_INITDB_ROOT_USERNAME=syntask
MONGO_INITDB_ROOT_PASSWORD=replace-with-a-strong-mongodb-password
MONGODB_URL=mongodb://syntask:replace-with-a-strong-mongodb-password@mongo:27017/alphanexis_task_management?authSource=admin
DATABASE_NAME=alphanexis_task_management

# CORS and frontend URLs
ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:5173","http://127.0.0.1:5173","https://synzent.ai","https://www.synzent.ai"]
ALLOWED_HOSTS=["localhost","127.0.0.1","synzent.ai","www.synzent.ai","backend"]
FRONTEND_URL=http://localhost:3000

# Email
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@alphanexis.com
MAIL_FROM_NAME=SynTask
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_TLS=True
MAIL_SSL=False

# IMAP recruitment inbox sync
IMAP_ENABLED=False
IMAP_HOST=
IMAP_PORT=993
IMAP_SSL=True
IMAP_USERNAME=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX
IMAP_POLL_SECONDS=60
IMAP_MARK_SEEN=True
IMAP_TARGET_COMPANY_EMAIL=

# Recruitment advanced workflows
RECRUITMENT_RESUME_MAX_BYTES=5242880
RECRUITMENT_OFFER_TOKEN_TTL_DAYS=7
RECRUITMENT_INTERVIEW_REMINDER_HOURS=[24,1]
RECRUITMENT_OFFER_REMINDER_DAYS=[2,0]
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=
MICROSOFT_REDIRECT_URI=http://localhost:8000/api/v1/recruitment/integrations/microsoft/connect
MICROSOFT_SCOPES=["offline_access","Calendars.ReadWrite","OnlineMeetings.ReadWrite","User.Read"]
MICROSOFT_GRAPH_SCOPES=["offline_access","Calendars.ReadWrite","OnlineMeetings.ReadWrite","User.Read"]
MICROSOFT_TOKEN_ENCRYPTION_KEY=

# Brevo
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=SynTask
BREVO_REPLY_TO=
BREVO_BASE_URL=https://api.brevo.com/v3
BREVO_TIMEOUT_SECONDS=20
BREVO_RETRY_ATTEMPTS=3

# eTimeOffice biometric attendance integration (server-side only; never expose to frontend/APIs/logs)
ETIMEOFFICE_ENABLED=False
ETIMEOFFICE_WEB_BASE_URL=https://etimeoffice.com
ETIMEOFFICE_API_BASE_URL=https://api.etimeoffice.com/api
ETIMEOFFICE_CORPORATE_ID=
ETIMEOFFICE_USERNAME=
ETIMEOFFICE_PASSWORD=
# Timezone of the eTimeOffice corporate clock (device wall times are interpreted in this zone)
ETIMEOFFICE_TIMEZONE=Asia/Kolkata
# Automatic sync cadence and default look-back window
ETIMEOFFICE_SYNC_INTERVAL_SECONDS=180
ETIMEOFFICE_SYNC_LOOKBACK_DAYS=7

# Payments
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Toggle real Razorpay collection for invoice payments. False keeps local/manual payment testing enabled without hitting Razorpay.
RAZORPAY_INVOICE_PAYMENTS_ENABLED=False

# Zoom
ZOOM_API_KEY=
ZOOM_API_SECRET=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_ACCOUNT_ID=

# File uploads and storage
MAX_UPLOAD_SIZE=10485760
ALLOWED_EXTENSIONS=[".jpg",".jpeg",".png",".gif",".webp",".pdf",".doc",".docx",".pptx",".xls",".xlsx",".csv",".html",".htm",".txt",".zip"]
UPLOAD_DIR=uploads

# Central RAG foundation (Milestone 1+). Development Compose pins Qdrant server v1.14.1 with qdrant-client==1.14.3.
RAG_ENABLED=false
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=syntask_rag_text_embedding_3_small_1536
QDRANT_DEPLOYMENT_MODE=shared
QDRANT_TIMEOUT_SECONDS=10
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536
RAG_MAX_UPLOAD_SIZE=26214400
RAG_PDF_MAX_PAGES=200
RAG_CHUNK_MAX_TOKENS=700
RAG_CHUNK_OVERLAP_TOKENS=80
RAG_RETRIEVAL_TOP_K=5
RAG_CITATION_EXCERPT_CHARS=600
RAG_AUDIT_RETENTION_DAYS=90
RAG_WORKING_MEMORY_IDLE_TTL_SECONDS=1800
RAG_WORKING_MEMORY_ABSOLUTE_TTL_SECONDS=28800
RAG_WORKING_MEMORY_MAX_MESSAGES=20
RAG_WORKING_MEMORY_MAX_TOOL_OUTPUTS=10
RAG_WORKING_MEMORY_MAX_ENTITIES=25
RAG_WORKING_MEMORY_MESSAGE_CHARS=1000
RAG_WORKING_MEMORY_TOOL_OUTPUT_CHARS=1500
RAG_CONTEXT_PACKAGE_MAX_ITEMS=20
RAG_CONTEXT_PACKAGE_MAX_CHARS=6000
RAG_LOG_RAW_CONTEXT=false
RAG_LOG_FULL_PROMPTS=false
RAG_QUERY_UNDERSTANDING_VERSION=query-understanding-v1
RAG_QUERY_MAX_REWRITES=3
RAG_QUERY_MAX_SUBQUERIES=3
RAG_HYBRID_COLLECTION=syntask_rag_hybrid_v1_text_embedding_3_small_1536
RAG_DENSE_VECTOR_NAME=dense
RAG_SPARSE_VECTOR_NAME=sparse
RAG_SPARSE_ENCODER_VERSION=sparse-hash-v1
RAG_HYBRID_PREFETCH_LIMIT=20
RAG_MIN_EVIDENCE_SCORE=0.2
RAG_OFFICE_MAX_UNCOMPRESSED_BYTES=50000000
RAG_XLSX_MAX_SHEETS=30
RAG_XLSX_MAX_ROWS=5000
RAG_PPTX_MAX_SLIDES=300
RAG_CSV_MAX_ROWS=10000

# Shared Agent Platform foundation
AGENT_PLATFORM_ENABLED=true
AGENT_RUN_RETENTION_DAYS=90
AGENT_RUN_EVENT_RETENTION_DAYS=180
AGENT_SANITIZED_OUTPUT_RETENTION_DAYS=90
AGENT_PROPOSAL_RETENTION_DAYS=90
AGENT_EVALUATION_RETENTION_DAYS=180
AGENT_DEFAULT_RUN_TIMEOUT_SECONDS=30
AGENT_DEFAULT_MAX_TOKENS_PER_RUN=4000
AGENT_DEFAULT_MAX_COST_PER_RUN=1.0
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET_NAME=
AWS_REGION=us-east-1

# Redis configuration (Upstash)
REDIS_URL=redis://default:<YOUR_UPSTASH_PASSWORD>@grand-panther-150790.upstash.io:6379

# Celery configuration – now points to Redis
CELERY_BROKER_URL=${REDIS_URL}
CELERY_RESULT_BACKEND=${REDIS_URL}

# Meta integration (disabled by default)
META_INTEGRATION_ENABLED=False
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=
META_BUSINESS_ID=
META_AD_ACCOUNT_ID=
META_SYSTEM_USER_TOKEN=
META_LEAD_FORM_ID=
META_WHATSAPP_BUSINESS_ID=

# Pagination and rate limits
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=500
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=60
AUTH_RATE_LIMIT_REQUESTS=10
AUTH_RATE_LIMIT_PERIOD=60

# Logging and AI
LOG_LEVEL=INFO
AI_PROVIDER=groq
GROQ_API_KEY=
OPENAI_API_KEY=
AI_TIMEOUT=30
AI_MAX_TOKENS=500
AI_TEMPERATURE=0.2
AI_MODEL_GROQ=llama-3.1-70b-versatile
AI_MODEL_OPENAI=gpt-4o-mini
GROQ_BASE_URL=https://api.groq.com/openai/v1

# HR Operations Agent
HR_AGENT_ENABLED=false
HR_AGENT_MAX_STEPS=15
HR_AGENT_MODEL=

# Executive Operations Agent
EXECUTIVE_AGENT_ENABLED=false
EXECUTIVE_AGENT_MAX_STEPS=20
EXECUTIVE_AGENT_MODEL=

# Bootstrap access
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=replace-with-a-strong-bootstrap-password
