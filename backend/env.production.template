# Production Environment Variables Template
# Copy this file to .env and update with your actual values

ENVIRONMENT=production

# SECURITY: Generate a strong secret key (minimum 32 characters)
# Use: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=YOUR_SECRET_KEY_HERE_MIN_32_CHARS_CHANGE_THIS
ENCRYPTION_KEY=YOUR_FERNET_KEY_HERE_CHANGE_THIS

# MongoDB connection string
MONGODB_URL=mongodb://mongo:27017/alphanexis_task_management
DATABASE_NAME=alphanexis_task_management

# CORS - Production Domain
ALLOWED_ORIGINS=["https://task.synzent.ai"]
ALLOWED_HOSTS=["task.synzent.ai"]
FRONTEND_URL=https://task.synzent.ai

# Email Configuration (Optional)
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_FROM=noreply@alphanexis.com
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_TLS=True

# IMAP recruitment inbox sync
IMAP_ENABLED=False
IMAP_HOST=
IMAP_PORT=993
IMAP_SSL=True
IMAP_USERNAME=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX
IMAP_POLL_SECONDS=60
IMAP_MARK_SEEN=True
IMAP_TARGET_COMPANY_EMAIL=

# Payment Gateways (Optional)
STRIPE_SECRET_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Redis (Optional, for caching)
REDIS_URL=redis://redis:6379/0
ENABLE_TOKEN_REVOCATION=True

# Super Admin
SUPER_ADMIN_EMAIL=admin@alphanexis.com
SUPER_ADMIN_PASSWORD=CHANGE_THIS_TO_A_STRONG_BOOTSTRAP_PASSWORD

# Auth Rate Limiting
AUTH_RATE_LIMIT_REQUESTS=10
AUTH_RATE_LIMIT_PERIOD=60

# Logging
LOG_LEVEL=INFO
