    {
      "id": "hr-candidate-ananya-rao-001",
      "category": "correctness",
      "query": "Do we have a candidate named Ananya Rao in our recruitment pipeline? What is her current status?",
      "expected": {
        "required_tools": ["search_candidates"],
        "tool_result_assertions": [
          {"tool": "search_candidates", "path": "$.total", "op": "equals", "value": 1, "message": "exactly one candidate named Ananya Rao exists"},
          {"tool": "search_candidates", "path": "$.candidates[0].full_name", "op": "contains", "value": "Ananya Rao", "message": "candidate full name matches"}
        ],
        "answer_contains_any": ["Ananya", "Rao", "shortlisted", "candidate", "pipeline"],
        "max_groq_calls": 4,
        "max_tool_calls": 8,
        "max_latency_ms": 120000
      },
      "critical": false
    },
    {
