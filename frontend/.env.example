[TEMPLATE]
# SynTask frontend environment example
# Copy this file to frontend/.env for local development.

# Preferred (default): the Vite dev server proxies /api to the backend
# (see vite.config.js → server.proxy), so requests are SAME-ORIGIN and never
# pay CORS preflight costs. Leave VITE_API_URL unset to use the proxy.
# VITE_API_URL=/api/v1

# Alternative (NOT recommended for local dev): call the backend directly.
# A cross-origin base URL makes every request CORS-preflight (the app sends an
# Authorization header), roughly doubling request time on initial page loads.
# VITE_API_URL=http://localhost:8000/api/v1
VITE_LOGIN_URL=http://localhost:3000/login
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
VITE_UNIFIED_AI_ASSISTANT_ENABLED=true
VITE_HR_AGENT_ENABLED=true
VITE_EXECUTIVE_AGENT_ENABLED=true
