# SynTask frontend environment example
# Copy this file to frontend/.env for local development.

VITE_API_URL=http://localhost:8000/api/v1
VITE_LOGIN_URL=http://localhost:3000/login
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
VITE_UNIFIED_AI_ASSISTANT_ENABLED=false
VITE_HR_AGENT_ENABLED=false
VITE_EXECUTIVE_AGENT_ENABLED=false
